uses(TestCase::class, RefreshDatabase::class)->in(__FILE__);

beforeEach(function (): void {
    expect(config('database.default'))->toBe('sqlite')
        ->and(config('database.connections.sqlite.database'))->toBe(':memory:');
    $this->seed(RolePermissionSeeder::class);
});

function permanentUser(string $role = 'project_manager'): User
{
    $user = User::factory()->create();
    $user->assignRole($role);
    return $user;
}

function permanentProject(User $owner): \Modules\Projects\Models\Project
{
    $project = app(ProjectService::class)->create($owner, new ProjectData('Regression '.uniqid(), null, null, null));
    return app(ProjectService::class)->activate($project, $owner);
}

function permanentUploadedAttachment(string $name, string $contents, string $clientMimeType): UploadedFile
{
    $path = tempnam(sys_get_temp_dir(), 'taskflow-attachment-');
    file_put_contents($path, $contents);

    return new UploadedFile($path, $name, $clientMimeType, null, true);
}

// Authentication, Projects, Membership, Tasks, Status, Comments, Attachments
test('core TaskFlow workflow uses the isolated testing database', function (): void {
    $manager = permanentUser();
    $member = permanentUser('member');
    $project = permanentProject($manager);
    app(ProjectMemberService::class)->addMember($project, $member, ProjectMemberRole::Member, actor: $manager);
    $task = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'Regression task', 'priority' => TaskPriority::Medium->value, 'assignee_id' => $member->id]));
    expect($task->creator_id)->toBe($manager->id)->and($task->status->value)->toBe('todo')->and($task->number)->toMatch('/^TSK-\\d{6}$/');
    $this->get('/login')->assertOk()->assertSee('TaskFlow');
    $this->actingAs($member)->get(route('tasks.show', $task))->assertOk();
});

// Activity, Dashboard, Navigation
test('activity dashboard and navigation use scoped real application services', function (): void {
    $admin = permanentUser('admin');
    $manager = permanentUser();
    $project = permanentProject($manager);
    app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'Dashboard task', 'priority' => 'medium']));
    expect(app(ActivityQueryService::class)->paginate($admin, ['project' => $project->id])->total())->toBeGreaterThan(0)
        ->and(app(DashboardService::class)->summary($manager)['totalTasks'])->toBe(1);
    $this->actingAs($admin)->get('/activity')->assertOk()->assertSee('aria-current="page"', false);
    $this->actingAs($admin)->get('/dashboard')->assertOk()->assertSee('aria-current="page"', false);
});

// Task Status Regression
test('Task Status transitions and timestamps are enforced by the service', function (): void {
    $manager = permanentUser(); $member = permanentUser('member'); $project = permanentProject($manager);
    app(ProjectMemberService::class)->addMember($project, $member, ProjectMemberRole::Member, actor: $manager);
    $task = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title'=>'Status task','priority'=>'medium','assignee_id'=>$member->id]));
    $status = app(TaskStatusService::class);
    expect(fn()=> $status->change($task, TaskStatus::Review, $manager))->toThrow(InvalidTaskStatusTransition::class);
    $task=$status->change($task,TaskStatus::InProgress,$manager); expect($task->started_at)->not->toBeNull();
    $task=$status->change($task,TaskStatus::Todo,$manager); expect($task->started_at)->not->toBeNull();
    $task=$status->change($task,TaskStatus::Cancelled,$manager); expect($task->completed_at)->toBeNull();
    $task=$status->change($task,TaskStatus::Todo,$manager); $task=$status->change($task,TaskStatus::InProgress,$manager); $task=$status->change($task,TaskStatus::Review,$manager); $task=$status->change($task,TaskStatus::Done,$manager); expect($task->completed_at)->not->toBeNull();
    expect(fn()=> $status->change($task->fresh(),TaskStatus::InProgress,$member))->toThrow(InvalidTaskStatusTransition::class);
    expect($status->change($task->fresh(),TaskStatus::InProgress,$manager)->completed_at)->toBeNull();
    $cancelled=app(TaskService::class)->create($manager,$project,CreateTaskData::fromArray($project->id,['title'=>'Cancelled','priority'=>'medium','assignee_id'=>$member->id])); $cancelled=$status->change($cancelled,TaskStatus::Cancelled,$manager);
    expect(fn()=> $status->change($cancelled->fresh(),TaskStatus::Todo,$member))->toThrow(InvalidTaskStatusTransition::class);
    expect($status->change($cancelled->fresh(),TaskStatus::Todo,$manager)->status)->toBe(TaskStatus::Todo);
});

// Comments Regression
test('Comments validate authorization rendering escaping and soft deletion', function (): void {
    $manager=permanentUser(); $member=permanentUser('member'); $outsider=permanentUser('member'); $project=permanentProject($manager); app(ProjectMemberService::class)->addMember($project,$member,ProjectMemberRole::Member,actor:$manager);
    $task=app(TaskService::class)->create($manager,$project,CreateTaskData::fromArray($project->id,['title'=>'Comment task','priority'=>'medium','assignee_id'=>$member->id]));
    $this->actingAs($outsider)->post(route('tasks.comments.store',$task),['body'=>'no'])->assertForbidden();
    $this->actingAs($manager)->post(route('tasks.comments.store',$task),['body'=>''])->assertSessionHasErrors('body');
    $body='<scr'.'ipt>alert('."'taskflow'".')</scr'.'ipt>'; $comment=app(TaskCommentService::class)->create($task,$manager,$body);
    expect($comment->task_id)->toBe($task->id)->and($comment->user_id)->toBe($manager->id);
    $this->actingAs($manager)->get(route('tasks.show',$task))->assertDontSee($body,false)->assertSee('&lt;script&gt;',false);
    $this->actingAs($member)->delete(route('tasks.comments.destroy',[$task,$comment]))->assertForbidden();
    $this->actingAs($manager)->delete(route('tasks.comments.destroy',[$task,$comment]))->assertRedirect(); $this->assertSoftDeleted('task_comments',['id'=>$comment->id]);
});

// Attachments Regression
test('Attachments validate privacy metadata and storage cleanup', function (): void {
    Storage::fake('local'); $manager=permanentUser(); $member=permanentUser('member'); $outsider=permanentUser('member'); $project=permanentProject($manager); app(ProjectMemberService::class)->addMember($project,$member,ProjectMemberRole::Member,actor:$manager);
    $task=app(TaskService::class)->create($manager,$project,CreateTaskData::fromArray($project->id,['title'=>'Attachment task','priority'=>'medium','assignee_id'=>$member->id]));
    $file=UploadedFile::fake()->create('proof.pdf',10,'application/pdf'); $attachment=app(TaskAttachmentService::class)->upload($task,$member,$file);
    expect($attachment->task_id)->toBe($task->id)->and($attachment->uploaded_by)->toBe($member->id)->and($attachment->original_name)->toBe('proof.pdf'); Storage::disk('local')->assertExists($attachment->path);
    $this->actingAs($outsider)->get(route('tasks.attachments.download',[$task,$attachment]))->assertForbidden(); $this->actingAs($member)->get(route('tasks.attachments.download',[$task,$attachment]))->assertOk();
    $this->actingAs($outsider)->delete(route('tasks.attachments.destroy',[$task,$attachment]))->assertForbidden(); $this->actingAs($manager)->delete(route('tasks.attachments.destroy',[$task,$attachment]))->assertRedirect(); $this->assertDatabaseMissing('task_attachments',['id'=>$attachment->id]); Storage::disk('local')->assertMissing($attachment->path);
});

test('Comments reject bodies longer than the configured maximum', function (): void {
    $manager = permanentUser(); $project = permanentProject($manager);
    $task = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title'=>'Max comment','priority'=>'medium']));
    $this->actingAs($manager)->post(route('tasks.comments.store', $task), ['body'=>str_repeat('a', 5001)])->assertSessionHasErrors('body');
    $this->assertDatabaseCount('task_comments', 0);
});

test('Attachments reject invalid and oversized uploads while keeping UI storage details private', function (): void {
    Storage::fake('local'); $manager=permanentUser(); $member=permanentUser('member'); $project=permanentProject($manager); app(ProjectMemberService::class)->addMember($project,$member,ProjectMemberRole::Member,actor:$manager);
    $task=app(TaskService::class)->create($manager,$project,CreateTaskData::fromArray($project->id,['title'=>'Upload validation','priority'=>'medium','assignee_id'=>$member->id]));
    $this->actingAs($manager)->post(route('tasks.attachments.store',$task),['attachment'=>UploadedFile::fake()->create('blocked.exe',1,'application/octet-stream')])->assertSessionHasErrors('attachment');
    $this->actingAs($manager)->post(route('tasks.attachments.store',$task),['attachment'=>UploadedFile::fake()->create('large.pdf',10241,'application/pdf')])->assertSessionHasErrors('attachment');
    $image=UploadedFile::fake()->image('image.png'); $attachment=app(TaskAttachmentService::class)->upload($task,$member,$image); Storage::disk('local')->assertExists($attachment->path);
    $response=$this->actingAs($manager)->get(route('tasks.show',$task)); $response->assertSee('image.png')->assertDontSee($attachment->path);
    expect($response->getContent())->not->toContain('disk="'.$attachment->disk.'"');
});

// Activity Regression
test('Activity records canonical task changes once and filters by event project task actor and date', function (): void {
    $admin=permanentUser('admin'); $actor=permanentUser(); $other=permanentUser(); $projectA=permanentProject($actor); $projectB=permanentProject($other);
    $taskA=app(TaskService::class)->create($actor,$projectA,CreateTaskData::fromArray($projectA->id,['title'=>'Activity A','priority'=>'medium']));
    $taskB=app(TaskService::class)->create($other,$projectB,CreateTaskData::fromArray($projectB->id,['title'=>'Activity B','priority'=>'medium']));
    app(TaskStatusService::class)->change($taskA,TaskStatus::InProgress,$actor);
    $status=Activity::query()->where('event','task.status_changed')->where('properties->task_id',$taskA->id)->sole();
    expect(Activity::query()->where('event','task.created')->where('properties->task_id',$taskA->id)->count())->toBe(1)
        ->and(Activity::query()->whereKey($status->id)->count())->toBe(1)
        ->and($status->properties->get('old'))->toBe('todo')->and($status->properties->get('new'))->toBe('in_progress');
    $service=app(ActivityQueryService::class);
    expect($service->paginate($admin,['event'=>'task.created'])->pluck('event')->unique()->all())->toBe(['task.created']);
    expect($service->paginate($admin,['project'=>$projectA->id])->pluck('id'))->not->toContain(Activity::query()->where('properties->project_id',$projectB->id)->value('id'));
    expect($service->paginate($admin,['task'=>$taskA->id])->pluck('id'))->not->toContain(Activity::query()->where('properties->task_id',$taskB->id)->value('id'));
    expect($service->paginate($admin,['actor'=>$actor->id])->pluck('causer_id')->unique()->all())->toBe([$actor->id]);
    $status->created_at=now()->subDay(); $status->save();
    expect($service->paginate($admin,['date_from'=>now()->subDays(2)->toDateString(),'date_to'=>now()->toDateString()])->pluck('id'))->toContain($status->id);
});

test('Activity page scopes managed projects and forbids users without permission', function (): void {
    $manager=permanentUser(); $outsider=permanentUser(); $plain=User::factory()->create(); $managed=permanentProject($manager); $other=permanentProject($outsider);
    app(TaskService::class)->create($manager,$managed,CreateTaskData::fromArray($managed->id,['title'=>'Managed marker','priority'=>'medium']));
    app(TaskService::class)->create($outsider,$other,CreateTaskData::fromArray($other->id,['title'=>'Other marker','priority'=>'medium']));
    $this->actingAs($manager)->get('/activity')->assertOk()->assertSee('Managed marker')->assertDontSee('Other marker');
    $this->actingAs($plain)->get('/activity')->assertForbidden();
});

test('Activity metadata omits private attachment paths and sensitive security fields', function (): void {
    Storage::fake('local'); $manager=permanentUser(); $project=permanentProject($manager);
    $task=app(TaskService::class)->create($manager,$project,CreateTaskData::fromArray($project->id,['title'=>'Secure activity','priority'=>'medium']));
    $status=app(TaskStatusService::class)->change($task,TaskStatus::InProgress,$manager);
    $comment=app(TaskCommentService::class)->create($task,$manager,'Security activity comment');
    $attachment=app(TaskAttachmentService::class)->upload($task,$manager,UploadedFile::fake()->create('private.pdf',1,'application/pdf'));
    $properties=Activity::query()->whereIn('event',['task.status_changed','comment.created','attachment.uploaded'])->get()->map(fn($activity)=>json_encode($activity->properties))->implode(' ');
    expect($properties)->not->toContain($attachment->path)->not->toContain('password')->not->toContain('token')->not->toContain('session')->not->toContain('csrf');
});

test('Activity includes project-context managers and combines project with event filters', function (): void {
    $owner=permanentUser(); $contextManager=permanentUser(); $other=permanentUser(); $managed=permanentProject($owner); $unrelated=permanentProject($other);
    app(ProjectMemberService::class)->addMember($managed,$contextManager,ProjectMemberRole::Manager,actor:$owner);
    $task=app(TaskService::class)->create($owner,$managed,CreateTaskData::fromArray($managed->id,['title'=>'Context alpha','priority'=>'medium']));
    app(TaskService::class)->create($other,$unrelated,CreateTaskData::fromArray($unrelated->id,['title'=>'Context beta','priority'=>'medium']));
    $rows=app(ActivityQueryService::class)->paginate($contextManager,['project'=>$managed->id,'event'=>'task.created']);
    expect($rows->total())->toBe(1)->and($rows->first()->properties->get('project_id'))->toBe($managed->id);
});

