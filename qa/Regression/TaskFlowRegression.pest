    $alpha=app(TaskService::class)->create($manager,$project,CreateTaskData::fromArray($project->id,['title'=>'Embedded Alpha','priority'=>'medium']));
    $beta=app(TaskService::class)->create($manager,$project,CreateTaskData::fromArray($project->id,['title'=>'Embedded Beta','priority'=>'medium']));
    $this->actingAs($manager)->get(route('tasks.show',$alpha))->assertOk()->assertSee('Embedded Alpha')->assertDontSee('Embedded Beta')->assertSee('Task created')->assertDontSee('task.created');
});

test('Project embedded Activity renders only the current project in human readable form', function (): void {
    $manager=permanentUser(); $alpha=permanentProject($manager); $alpha->update(['name'=>'Project Alpha Marker']);
    $other=permanentUser(); $beta=permanentProject($other); $beta->update(['name'=>'Project Beta Marker']);
    app(ProjectService::class)->update($alpha,new ProjectData('Project Alpha Marker Updated',null,null,null),$manager);
    app(ProjectService::class)->update($beta,new ProjectData('Project Beta Marker Updated',null,null,null),$other);
    $this->actingAs($manager)->get(route('projects.show',$alpha))->assertOk()->assertSee('Project Alpha Marker Updated')->assertDontSee('Project Beta Marker Updated')->assertSee('Project updated')->assertDontSee('project.updated');
});

test('Embedded Activity requires activity view without changing Project or Task visibility', function (): void {
    $admin=permanentUser('admin'); $manager=permanentUser(); $member=permanentUser('member'); $other=permanentUser();
    $project=permanentProject($manager); app(ProjectMemberService::class)->addMember($project,$member,ProjectMemberRole::Member,actor:$manager);
    $task=app(TaskService::class)->create($manager,$project,CreateTaskData::fromArray($project->id,['title'=>'Authorized embedded task','priority'=>'medium','assignee_id'=>$member->id]));
    app(TaskStatusService::class)->change($task,TaskStatus::InProgress,$manager);
    $unrelated=permanentProject($other);
    $unrelatedTask=app(TaskService::class)->create($other,$unrelated,CreateTaskData::fromArray($unrelated->id,['title'=>'Unrelated embedded task','priority'=>'medium']));
    app(TaskStatusService::class)->change($unrelatedTask,TaskStatus::InProgress,$other);

    expect($member->hasPermissionTo(\App\Enums\PermissionName::ActivityView->value))->toBeFalse();
    $this->actingAs($member)->get(route('projects.show',$project))->assertOk()->assertSee($project->name)->assertDontSee('Recent activity')->assertDontSee('Task status changed');
    $this->actingAs($member)->get(route('tasks.show',$task))->assertOk()->assertSee('Authorized embedded task')->assertDontSee('Recent activity')->assertDontSee('Task status changed');
    $this->actingAs($admin)->get(route('projects.show',$project))->assertOk()->assertSee('Recent activity')->assertSee('Authorized embedded task')->assertDontSee('Unrelated embedded task');
    $this->actingAs($manager)->get(route('tasks.show',$task))->assertOk()->assertSee('Recent activity')->assertSee('Task status changed')->assertDontSee('Unrelated embedded task');
});

test('Archived Projects are read-only across Web API policies and services', function (): void {
    $owner = permanentUser();
    $admin = permanentUser('admin');
    $contextManager = permanentUser();
    $candidate = User::factory()->create();
    $projects = app(ProjectService::class);
    $members = app(ProjectMemberService::class);
    $tasks = app(TaskService::class);
    $project = permanentProject($owner);

    $members->addMember($project, $contextManager, ProjectMemberRole::Manager, actor: $owner);
    $members->addMember($project, $candidate, ProjectMemberRole::Member, actor: $owner);
    $this->actingAs($owner)->get(route('projects.show', $project))->assertOk()->assertSee('Edit project')->assertSee('Manage members')->assertSee('Create task');
    $this->actingAs($contextManager)->get(route('projects.members.index', $project))->assertOk();

    $draft = $projects->create($owner, new ProjectData('Draft activation '.uniqid(), null, null, null));
    $this->actingAs($owner)->patch(route('projects.activate', $draft))->assertRedirect();
    expect($draft->fresh()->status)->toBe(\Modules\Projects\Enums\ProjectStatus::Active);

    $projects->archive($project, $owner);
    $project->refresh();

    $this->actingAs($owner)->get(route('projects.show', $project))
        ->assertOk()
        ->assertSee($project->name)
        ->assertSee('This project is archived and is read-only.')
        ->assertSee('View tasks')
        ->assertDontSee('Edit project')
        ->assertDontSee('Activate project')
        ->assertDontSee('Manage members')
        ->assertDontSee('Create task')
        ->assertDontSee('>Archive<', false);
    $this->actingAs($owner)->get(route('projects.edit', $project))->assertForbidden();
    $this->actingAs($owner)->put(route('projects.update', $project), ['name' => 'Blocked archived update', 'description' => null])->assertForbidden();
    $this->actingAs($owner)->patch(route('projects.activate', $project))->assertForbidden();
    $this->actingAs($owner)->patch(route('projects.archive', $project))->assertForbidden();
    $this->actingAs($owner)->post(route('projects.members.store', $project), ['user_id' => $admin->id, 'member_role' => 'member'])->assertForbidden();
    $this->actingAs($owner)->delete(route('projects.members.destroy', [$project, $candidate]))->assertForbidden();
    $this->actingAs($owner)->post(route('tasks.store', $project), ['title' => 'Blocked archived task', 'priority' => 'medium'])->assertForbidden();

    $data = new ProjectData('Blocked archived update', null, null, null);
    expect(fn () => $projects->update($project, $data, $admin))->toThrow(\LogicException::class)
        ->and(fn () => $projects->activate($project, $admin))->toThrow(\LogicException::class)
        ->and(fn () => $projects->archive($project, $admin))->toThrow(\LogicException::class)
        ->and(fn () => $members->addMember($project, $admin, ProjectMemberRole::Member, actor: $admin))->toThrow(\LogicException::class)
        ->and(fn () => $members->removeMember($project, $candidate, $admin))->toThrow(\LogicException::class)
        ->and(fn () => $tasks->create($admin, $project, CreateTaskData::fromArray($project->id, ['title' => 'Admin blocked archived task', 'priority' => 'medium'])))->toThrow(\LogicException::class);

    permanentApiActor($owner, ['projects:write']);
    $this->patchJson('/api/v1/projects/'.$project->id, ['name' => 'Blocked API update', 'description' => null])->assertConflict();
    permanentApiActor($owner, ['projects:write']);
    $this->postJson('/api/v1/projects/'.$project->id.'/activate')->assertConflict();
    permanentApiActor($owner, ['projects:write']);
    $this->postJson('/api/v1/projects/'.$project->id.'/archive')->assertConflict();
    permanentApiActor($owner, ['projects:write']);
    $this->postJson('/api/v1/projects/'.$project->id.'/members', ['user_id' => $admin->id, 'member_role' => 'member'])->assertConflict();
    permanentApiActor($owner, ['projects:write']);
    $this->deleteJson('/api/v1/projects/'.$project->id.'/members/'.$candidate->id)->assertConflict();
    permanentApiActor($admin, ['tasks:write']);
    $this->postJson('/api/v1/tasks', ['project_id' => $project->id, 'title' => 'Blocked API task', 'priority' => 'medium'])->assertConflict();
});

// Dashboard Regression
test('Dashboard enforces permission and scopes manager member metrics and my tasks', function (): void {
    $plain=User::factory()->create(); $this->actingAs($plain)->get('/dashboard')->assertForbidden();
    $owner=permanentUser(); $context=permanentUser(); $member=permanentUser('member'); $other=permanentUser();
    $managed=permanentProject($owner); $unrelated=permanentProject($other);
    app(ProjectMemberService::class)->addMember($managed,$context,ProjectMemberRole::Manager,actor:$owner); app(ProjectMemberService::class)->addMember($managed,$member,ProjectMemberRole::Member,actor:$owner);
    $assigned=app(TaskService::class)->create($owner,$managed,CreateTaskData::fromArray($managed->id,['title'=>'Assigned dashboard','priority'=>'medium','assignee_id'=>$member->id]));
    app(TaskService::class)->create($owner,$managed,CreateTaskData::fromArray($managed->id,['title'=>'Managed dashboard','priority'=>'medium'])); app(TaskService::class)->create($other,$unrelated,CreateTaskData::fromArray($unrelated->id,['title'=>'Unrelated dashboard','priority'=>'medium']));
    $dashboard=app(DashboardService::class);
    expect($dashboard->summary($context)['totalTasks'])->toBe(2)->and($dashboard->summary($member)['totalTasks'])->toBe(1)->and($dashboard->summary($member)['myTasks']->pluck('id')->all())->toContain($assigned->id);
});

// Navigation Regression
test('Dashboard navigation and guest routes retain semantic and access protection', function (): void {
    $admin=permanentUser('admin');
    $this->actingAs($admin)->get('/')->assertSee('href="http://localhost:8000/projects"',false)->assertSee('href="http://localhost:8000/tasks"',false)->assertSee('href="http://localhost:8000/activity"',false)->assertSee('href="http://localhost:8000/dashboard"',false)->assertDontSee('Coming soon');
    $this->actingAs($admin)->get('/dashboard')->assertOk()->assertSee('Dashboard')->assertSee('My Tasks')->assertSee('Recent Activity')->assertSee('aria-current="page"',false);
    $this->app['auth']->guard()->logout(); foreach(['/projects','/tasks','/activity','/dashboard'] as $path) $this->get($path)->assertRedirect('/login');
});

test('Dashboard returns exact admin metrics overdue and completed today values', function (): void {
    $admin=permanentUser('admin'); $owner=permanentUser(); $active=permanentProject($owner); $archived=permanentProject($admin);
    $todo=app(TaskService::class)->create($owner,$active,CreateTaskData::fromArray($active->id,['title'=>'Todo past','priority'=>'medium']));
    $progress=app(TaskService::class)->create($owner,$active,CreateTaskData::fromArray($active->id,['title'=>'Progress past','priority'=>'medium']));
    $review=app(TaskService::class)->create($admin,$archived,CreateTaskData::fromArray($archived->id,['title'=>'Review','priority'=>'medium']));
    $done=app(TaskService::class)->create($admin,$archived,CreateTaskData::fromArray($archived->id,['title'=>'Done','priority'=>'medium']));
    $cancelled=app(TaskService::class)->create($admin,$archived,CreateTaskData::fromArray($archived->id,['title'=>'Cancelled','priority'=>'medium']));
    $future=app(TaskService::class)->create($owner,$active,CreateTaskData::fromArray($active->id,['title'=>'Future todo','priority'=>'medium'])); $yesterday=app(TaskService::class)->create($admin,$archived,CreateTaskData::fromArray($archived->id,['title'=>'Yesterday done','priority'=>'medium']));
    $todo->update(['due_at'=>now()->subDay()]); $progress->update(['status'=>TaskStatus::InProgress,'due_at'=>now()->subDay()]); $review->update(['status'=>TaskStatus::Review]); $done->update(['status'=>TaskStatus::Done,'due_at'=>now()->subDay(),'completed_at'=>now()]); $cancelled->update(['status'=>TaskStatus::Cancelled,'due_at'=>now()->subDay()]); $future->update(['due_at'=>now()->addDay()]); $yesterday->update(['status'=>TaskStatus::Done,'completed_at'=>now()->subDay()]);
    app(ProjectService::class)->archive($archived,$admin); $summary=app(DashboardService::class)->summary($admin);
    expect($summary['activeProjects'])->toBe(1)->and($summary['archivedProjects'])->toBe(1)->and($summary['totalTasks'])->toBe(7)->and($summary['todo'])->toBe(2)->and($summary['inProgress'])->toBe(1)->and($summary['review'])->toBe(1)->and($summary['overdue'])->toBe(2)->and($summary['completedToday'])->toBe(1);
});

