});

test('Dashboard Recent Activity scopes admin managers context managers and members without leaks', function (): void {
    $admin=permanentUser('admin'); $a=permanentUser(); $b=permanentUser(); $pa=permanentProject($a); $pb=permanentProject($b);
    app(TaskService::class)->create($a,$pa,CreateTaskData::fromArray($pa->id,['title'=>'Admin Activity Alpha','priority'=>'medium'])); app(TaskService::class)->create($b,$pb,CreateTaskData::fromArray($pb->id,['title'=>'Admin Activity Beta','priority'=>'medium'])); $dash=app(DashboardService::class);
    $adminText=$dash->summary($admin)['recentActivity']->map(fn($x)=>json_encode($x->properties))->implode(' '); expect($adminText)->toContain('Admin Activity Alpha')->toContain('Admin Activity Beta');
    $managerText=$dash->summary($a)['recentActivity']->map(fn($x)=>json_encode($x->properties))->implode(' '); expect($managerText)->toContain('Admin Activity Alpha')->not->toContain('Admin Activity Beta');
    $context=permanentUser(); app(ProjectMemberService::class)->addMember($pa,$context,ProjectMemberRole::Manager,actor:$a); $contextText=$dash->summary($context)['recentActivity']->map(fn($x)=>json_encode($x->properties))->implode(' '); expect($contextText)->toContain('Admin Activity Alpha')->not->toContain('Admin Activity Beta');
    $member=permanentUser('member'); app(ProjectMemberService::class)->addMember($pa,$member,ProjectMemberRole::Member,actor:$a); $assigned=app(TaskService::class)->create($a,$pa,CreateTaskData::fromArray($pa->id,['title'=>'Member Activity Alpha','priority'=>'medium','assignee_id'=>$member->id])); app(TaskService::class)->create($a,$pa,CreateTaskData::fromArray($pa->id,['title'=>'Member Activity Beta','priority'=>'medium'])); $memberText=$dash->summary($member)['recentActivity']->map(fn($x)=>json_encode($x->properties))->implode(' '); expect($memberText)->toContain('Member Activity Alpha')->not->toContain('Member Activity Beta');
});

