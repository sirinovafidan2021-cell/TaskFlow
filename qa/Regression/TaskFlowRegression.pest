});

// API Regression
function permanentApiToken(User $user, array $abilities): string
{
    $token = $user->createToken('Regression token '.uniqid(), $abilities);
    expect($token->accessToken->can($abilities[0]))->toBeTrue();

    return $token->plainTextToken;
}

function permanentApiActor(User $user, array $abilities): void
{
    \Laravel\Sanctum\Sanctum::actingAs($user, $abilities);
}

test('API token management is permissioned, returns plaintext only once, and revocation invalidates authentication', function (): void {
    $manager = permanentUser();
    $admin = permanentUser('admin');
    $otherAdmin = permanentUser('admin');

    $this->getJson('/api/v1/tokens')->assertUnauthorized();
    $this->actingAs($manager)->postJson('/api/v1/tokens', ['name' => 'Denied', 'abilities' => ['projects:read']])->assertForbidden();
    $this->actingAs($admin)->postJson('/api/v1/tokens', ['name' => 'Invalid', 'abilities' => ['unknown:ability']])->assertUnprocessable()->assertJsonValidationErrors('abilities.0');

    $created = $this->actingAs($admin)->postJson('/api/v1/tokens', [
        'name' => 'Projects reader',
        'abilities' => ['projects:read', 'tasks:read'],
    ])->assertCreated()->assertJsonPath('data.token_type', 'Bearer')->assertJsonPath('data.abilities.0', 'projects:read');
    $plain = $created->json('data.token');
    $stored = $admin->tokens()->latest()->firstOrFail();
    expect($plain)->toBeString()->and($stored->token)->not->toBe($plain);

    $this->actingAs($admin)->getJson('/api/v1/tokens')->assertOk()->assertJsonMissing(['token' => $plain])->assertJsonMissing(['token' => $stored->token]);
    $foreign = $otherAdmin->createToken('Other token', ['projects:read'])->accessToken;
    $this->actingAs($admin)->deleteJson('/api/v1/tokens/'.$foreign->id)->assertNotFound();
    $this->actingAs($admin)->deleteJson('/api/v1/tokens/'.$stored->id)->assertNoContent();
    $this->withToken($plain)->getJson('/api/v1/projects')->assertUnauthorized();
});

test('Projects API requires abilities and policies, scopes results, and reuses the project service lifecycle', function (): void {
    $admin = permanentUser('admin');
    $manager = permanentUser();
    $member = permanentUser('member');
    $other = permanentUser();
    $owned = permanentProject($manager);
    $otherProject = permanentProject($other);
    app(ProjectMemberService::class)->addMember($owned, $member, ProjectMemberRole::Member, actor: $manager);

    permanentApiActor($manager, ['tasks:read']);
    $this->getJson('/api/v1/projects')->assertForbidden();
    permanentApiActor($member, ['projects:read']);
    $this->getJson('/api/v1/projects')
        ->assertOk()->assertJsonFragment(['id' => $owned->id])->assertJsonMissing(['id' => $otherProject->id]);
    permanentApiActor($admin, ['projects:read']);
    $this->getJson('/api/v1/projects')->assertOk()->assertJsonFragment(['id' => $owned->id])->assertJsonFragment(['id' => $otherProject->id]);
    permanentApiActor($manager, ['projects:read']);
    $this->getJson('/api/v1/projects?search='.urlencode(substr($owned->name, 0, 10)).'&status=active')
        ->assertOk()->assertJsonFragment(['id' => $owned->id]);

    permanentApiActor($manager, ['projects:read']);
    $this->postJson('/api/v1/projects', ['name' => 'Ability denied', 'description' => 'No write ability'])->assertForbidden();
    permanentApiActor($manager, ['projects:write']);
    $created = $this->postJson('/api/v1/projects', ['name' => 'API project', 'description' => 'Created through API'])
        ->assertCreated()->assertJsonPath('data.status', 'draft')->assertJsonPath('data.owner.id', $manager->id);
    $projectId = $created->json('data.id');
    $project = \Modules\Projects\Models\Project::query()->findOrFail($projectId);
    expect($project->slug)->not->toBeEmpty();
    $this->assertDatabaseHas('project_members', ['project_id' => $projectId, 'user_id' => $manager->id, 'member_role' => ProjectMemberRole::Manager->value]);

    permanentApiActor($manager, ['projects:write']);
    $this->postJson('/api/v1/projects/'.$projectId.'/activate')->assertOk()->assertJsonPath('data.status', 'active');
    permanentApiActor($manager, ['projects:write']);
    $this->patchJson('/api/v1/projects/'.$projectId, ['name' => 'API project updated', 'description' => null])->assertOk()->assertJsonPath('data.name', 'API project updated');
    permanentApiActor($manager, ['projects:write']);
    $this->postJson('/api/v1/projects/'.$projectId.'/archive')->assertOk()->assertJsonPath('data.status', 'archived');
});

test('Tasks API preserves scoped visibility, active-project and assignment rules, status services, and soft deletion', function (): void {
    $admin = permanentUser('admin');
    $manager = permanentUser();
    $member = permanentUser('member');
    $outsider = permanentUser('member');
    $otherManager = permanentUser();
    $project = permanentProject($manager);
    $otherProject = permanentProject($otherManager);
    app(ProjectMemberService::class)->addMember($project, $member, ProjectMemberRole::Member, actor: $manager);
    $draft = app(ProjectService::class)->create($manager, new ProjectData('API draft '.uniqid(), null, null, null));
    $otherTask = app(TaskService::class)->create($otherManager, $otherProject, CreateTaskData::fromArray($otherProject->id, ['title' => 'Unrelated API task', 'priority' => 'medium']));

    $this->getJson('/api/v1/tasks')->assertUnauthorized();
    permanentApiActor($manager, ['projects:read']);
    $this->getJson('/api/v1/tasks')->assertForbidden();
    permanentApiActor($manager, ['tasks:read']);
    $this->postJson('/api/v1/tasks', ['project_id' => $project->id, 'title' => 'Write ability required', 'priority' => 'medium'])->assertForbidden();
    permanentApiActor($manager, ['tasks:write']);
    $this->postJson('/api/v1/tasks', ['project_id' => $draft->id, 'title' => 'Draft blocked', 'priority' => 'medium'])->assertConflict();
    permanentApiActor($manager, ['tasks:write']);
    $created = $this->postJson('/api/v1/tasks', [
        'project_id' => $project->id,
        'title' => 'API task',
        'description' => 'Domain service task',
        'priority' => 'high',
        'assignee_id' => $member->id,
    ])->assertCreated()->assertJsonPath('data.status', 'todo')->assertJsonPath('data.priority', 'high')->assertJsonPath('data.creator.id', $manager->id);
    $taskId = $created->json('data.id');
    $task = \Modules\Tasks\Models\Task::query()->findOrFail($taskId);
    expect($task->number)->toMatch('/^TSK-\d{6}$/');

    permanentApiActor($manager, ['tasks:read']);
    $this->getJson('/api/v1/tasks')->assertOk()->assertJsonFragment(['id' => $taskId])->assertJsonMissing(['title' => 'Unrelated API task']);
    permanentApiActor($admin, ['tasks:read']);
    $this->getJson('/api/v1/tasks')->assertOk()->assertJsonFragment(['id' => $taskId])->assertJsonFragment(['id' => $otherTask->id]);
    permanentApiActor($member, ['tasks:read']);
    $this->getJson('/api/v1/tasks')->assertOk()->assertJsonFragment(['id' => $taskId]);
    permanentApiActor($outsider, ['tasks:read']);
    $this->getJson('/api/v1/tasks/'.$taskId)->assertForbidden();
    permanentApiActor($manager, ['tasks:write']);
    $this->patchJson('/api/v1/tasks/'.$taskId.'/assignee', ['assignee_id' => $outsider->id])->assertConflict();
    permanentApiActor($manager, ['tasks:write']);
    $this->patchJson('/api/v1/tasks/'.$taskId.'/assignee', ['assignee_id' => $member->id])->assertOk()->assertJsonPath('data.assignee.id', $member->id);
    permanentApiActor($manager, ['tasks:write']);
    $this->patchJson('/api/v1/tasks/'.$taskId, ['title' => 'Updated through API', 'description' => null, 'priority' => 'low'])->assertOk()->assertJsonPath('data.title', 'Updated through API');

    permanentApiActor($member, ['tasks:write']);
    $this->patchJson('/api/v1/tasks/'.$taskId.'/status', ['status' => 'review'])->assertConflict();
    permanentApiActor($member, ['tasks:write']);
    $this->patchJson('/api/v1/tasks/'.$taskId.'/status', ['status' => 'in_progress'])->assertOk()->assertJsonPath('data.status', 'in_progress');
    expect(\Modules\Tasks\Models\Task::query()->findOrFail($taskId)->started_at)->not->toBeNull();
    permanentApiActor($manager, ['tasks:write']);
    $this->patchJson('/api/v1/tasks/'.$taskId.'/status', ['status' => 'review'])->assertOk();
    permanentApiActor($manager, ['tasks:write']);
    $this->patchJson('/api/v1/tasks/'.$taskId.'/status', ['status' => 'done'])->assertOk()->assertJsonPath('data.status', 'done');
    expect(\Modules\Tasks\Models\Task::query()->findOrFail($taskId)->completed_at)->not->toBeNull();
    permanentApiActor($member, ['tasks:write']);
    $this->patchJson('/api/v1/tasks/'.$taskId.'/status', ['status' => 'in_progress'])->assertConflict();
    permanentApiActor($manager, ['tasks:write']);
    $this->patchJson('/api/v1/tasks/'.$taskId.'/status', ['status' => 'in_progress'])->assertOk()->assertJsonPath('data.completed_at', null);

    permanentApiActor($manager, ['tasks:write']);
    $this->deleteJson('/api/v1/tasks/'.$taskId)->assertNoContent();
    $this->assertSoftDeleted('tasks', ['id' => $taskId]);
});

test('Task comments API requires the correct ability, keeps task nesting safe, and returns safe resources', function (): void {
    $manager = permanentUser();
    $member = permanentUser('member');
    $project = permanentProject($manager);
    app(ProjectMemberService::class)->addMember($project, $member, ProjectMemberRole::Member, actor: $manager);
    $task = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'API comments', 'priority' => 'medium', 'assignee_id' => $member->id]));
    $otherTask = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'Other API comments', 'priority' => 'medium']));
    app(TaskCommentService::class)->create($otherTask, $manager, 'Other task comment');

    permanentApiActor($member, ['comments:write']);
    $this->getJson('/api/v1/tasks/'.$task->id.'/comments')->assertForbidden();
    permanentApiActor($member, ['tasks:read']);
    $this->getJson('/api/v1/tasks/'.$task->id.'/comments')->assertOk()->assertJsonMissing(['password' => $member->password])->assertJsonMissing(['body' => 'Other task comment']);
    permanentApiActor($member, ['tasks:read']);
    $this->postJson('/api/v1/tasks/'.$task->id.'/comments', ['body' => 'Ability denied'])->assertForbidden();
    permanentApiActor($member, ['comments:write']);
    $created = $this->postJson('/api/v1/tasks/'.$task->id.'/comments', ['body' => 'API comment'])
        ->assertCreated()->assertJsonPath('data.author.id', $member->id);
    $commentId = $created->json('data.id');
    permanentApiActor($member, ['comments:write']);
    $this->postJson('/api/v1/tasks/'.$task->id.'/comments', ['body' => str_repeat('a', 5001)])->assertUnprocessable()->assertJsonValidationErrors('body');
    permanentApiActor($manager, ['comments:write']);
    $this->deleteJson('/api/v1/tasks/'.$otherTask->id.'/comments/'.$commentId)->assertNotFound();
    permanentApiActor($member, ['comments:write']);
    $this->deleteJson('/api/v1/tasks/'.$task->id.'/comments/'.$commentId)->assertForbidden();
    permanentApiActor($manager, ['comments:write']);
    $this->deleteJson('/api/v1/tasks/'.$task->id.'/comments/'.$commentId)->assertNoContent();
    $this->assertSoftDeleted('task_comments', ['id' => $commentId]);
});

// TASK-028 API Completion Regression
test('Project members API uses abilities policies services and safe paginated resources', function (): void {
    $manager = permanentUser();
    $outsider = permanentUser();
    $member = permanentUser('member');
    $candidate = User::factory()->create();
    $project = permanentProject($manager);
    app(ProjectMemberService::class)->addMember($project, $member, ProjectMemberRole::Member, actor: $manager);

    $this->getJson('/api/v1/projects/'.$project->id.'/members')->assertUnauthorized();
    permanentApiActor($manager, ['tasks:read']);
    $this->getJson('/api/v1/projects/'.$project->id.'/members')->assertForbidden();
    permanentApiActor($outsider, ['projects:read']);
    $this->getJson('/api/v1/projects/'.$project->id.'/members')->assertForbidden();
    permanentApiActor($member, ['projects:read']);
    $this->getJson('/api/v1/projects/'.$project->id.'/members?per_page=1')->assertOk()->assertJsonPath('meta.per_page', 1)->assertJsonMissing(['password' => $member->password]);
    permanentApiActor($member, ['projects:read']);
    $this->getJson('/api/v1/projects/'.$project->id.'/members?per_page=101')->assertUnprocessable()->assertJsonValidationErrors('per_page');

    permanentApiActor($manager, ['projects:read']);
    $this->postJson('/api/v1/projects/'.$project->id.'/members', ['user_id' => $candidate->id, 'member_role' => 'member'])->assertForbidden();
    permanentApiActor($manager, ['projects:write']);
    $this->postJson('/api/v1/projects/'.$project->id.'/members', ['user_id' => $candidate->id, 'member_role' => 'member'])
        ->assertCreated()->assertJsonPath('data.user.id', $candidate->id)->assertJsonPath('data.member_role', 'member');
    $this->assertDatabaseHas('project_members', ['project_id' => $project->id, 'user_id' => $candidate->id, 'member_role' => 'member']);
    expect(\Modules\Projects\Models\ProjectMember::query()->where('project_id', $project->id)->where('user_id', $candidate->id)->sole()->joined_at)->not->toBeNull();
    expect(Activity::query()->where('event', 'project.member_added')->where('properties->member_id', $candidate->id)->exists())->toBeTrue();
    permanentApiActor($manager, ['projects:write']);
    $this->postJson('/api/v1/projects/'.$project->id.'/members', ['user_id' => $candidate->id, 'member_role' => 'member'])->assertConflict();
    permanentApiActor($manager, ['projects:write']);
    $this->deleteJson('/api/v1/projects/'.$project->id.'/members/'.$manager->id)->assertConflict();
    permanentApiActor($outsider, ['projects:write']);
    $this->deleteJson('/api/v1/projects/'.$project->id.'/members/'.$candidate->id)->assertForbidden();
    permanentApiActor($manager, ['projects:write']);
    $this->deleteJson('/api/v1/projects/'.$project->id.'/members/'.$candidate->id)->assertNoContent();
    expect(Activity::query()->where('event', 'project.member_removed')->where('properties->member_id', $candidate->id)->exists())->toBeTrue();
});

test('Attachments API protects task nesting storage metadata downloads and domain cleanup', function (): void {
    Storage::fake('local');
    $manager = permanentUser();
    $member = permanentUser('member');
    $project = permanentProject($manager);
    app(ProjectMemberService::class)->addMember($project, $member, ProjectMemberRole::Member, actor: $manager);
    $task = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'API attachment', 'priority' => 'medium', 'assignee_id' => $member->id]));
    $otherTask = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'Other API attachment', 'priority' => 'medium']));

    $this->getJson('/api/v1/tasks/'.$task->id.'/attachments')->assertUnauthorized();
    permanentApiActor($member, ['comments:write']);
    $this->getJson('/api/v1/tasks/'.$task->id.'/attachments')->assertForbidden();
    permanentApiActor($member, ['tasks:read']);
    $this->getJson('/api/v1/tasks/'.$task->id.'/attachments?per_page=1')->assertOk()->assertJsonPath('meta.per_page', 1);
    permanentApiActor($manager, ['tasks:read']);
    $this->post('/api/v1/tasks/'.$task->id.'/attachments', ['attachment' => UploadedFile::fake()->create('denied.pdf', 1, 'application/pdf')], ['Accept' => 'application/json'])->assertForbidden();
    permanentApiActor($manager, ['tasks:write']);
    $response = $this->post('/api/v1/tasks/'.$task->id.'/attachments', ['attachment' => permanentUploadedAttachment('proof.pdf', "%PDF-1.4\n1 0 obj\n<< /Type /Catalog >>\nendobj\n%%EOF\n", 'application/pdf')], ['Accept' => 'application/json'])
        ->assertCreated()->assertJsonPath('data.original_name', 'proof.pdf')->assertJsonPath('data.mime_type', 'application/pdf');
    $attachmentId = $response->json('data.id');
    $attachment = TaskAttachment::query()->findOrFail($attachmentId);
    Storage::disk('local')->assertExists($attachment->path);
    $response->assertJsonMissing(['disk' => $attachment->disk])->assertJsonMissing(['path' => $attachment->path]);
    permanentApiActor($manager, ['tasks:write']);
    $this->post('/api/v1/tasks/'.$task->id.'/attachments', ['attachment' => UploadedFile::fake()->image('proof.png')], ['Accept' => 'application/json'])->assertCreated();
    permanentApiActor($manager, ['tasks:write']);
    $this->post('/api/v1/tasks/'.$task->id.'/attachments', ['attachment' => UploadedFile::fake()->image('proof.jpg')], ['Accept' => 'application/json'])->assertCreated();
    permanentApiActor($manager, ['tasks:write']);
    $this->post('/api/v1/tasks/'.$task->id.'/attachments', ['attachment' => UploadedFile::fake()->image('proof.webp')], ['Accept' => 'application/json'])->assertCreated();
    $attachmentCountBeforeRejectedUpload = TaskAttachment::query()->count();
    $storedFilesBeforeRejectedUpload = Storage::disk('local')->allFiles("task-attachments/{$task->id}");
    permanentApiActor($manager, ['tasks:write']);
    $this->post('/api/v1/tasks/'.$task->id.'/attachments', ['attachment' => permanentUploadedAttachment('fake.pdf', "This is not a real PDF file.\n", 'application/pdf')], ['Accept' => 'application/json'])
        ->assertUnprocessable()
        ->assertJsonValidationErrors('attachment');
    expect(TaskAttachment::query()->count())->toBe($attachmentCountBeforeRejectedUpload)
        ->and(Storage::disk('local')->allFiles("task-attachments/{$task->id}"))->toBe($storedFilesBeforeRejectedUpload);
    permanentApiActor($manager, ['tasks:write']);
    $this->post('/api/v1/tasks/'.$task->id.'/attachments', ['attachment' => UploadedFile::fake()->create('blocked.exe', 1, 'application/octet-stream')], ['Accept' => 'application/json'])->assertUnprocessable();
    permanentApiActor($manager, ['tasks:write']);
    $this->post('/api/v1/tasks/'.$task->id.'/attachments', ['attachment' => UploadedFile::fake()->create('large.pdf', 10241, 'application/pdf')], ['Accept' => 'application/json'])->assertUnprocessable();
    permanentApiActor($member, ['tasks:read']);
    $this->get('/api/v1/tasks/'.$task->id.'/attachments/'.$attachmentId.'/download')->assertOk();
    permanentApiActor($manager, ['tasks:read']);
    $this->getJson('/api/v1/tasks/'.$otherTask->id.'/attachments/'.$attachmentId.'/download')->assertNotFound();
    permanentApiActor($manager, ['tasks:read']);
    $this->deleteJson('/api/v1/tasks/'.$task->id.'/attachments/'.$attachmentId)->assertForbidden();
    permanentApiActor($manager, ['tasks:write']);
    $this->deleteJson('/api/v1/tasks/'.$task->id.'/attachments/'.$attachmentId)->assertNoContent();
    Storage::disk('local')->assertMissing($attachment->path);
    expect(Activity::query()->where('event', 'attachment.deleted')->where('properties->attachment_id', $attachmentId)->exists())->toBeTrue();
});

test('Activity API preserves scoped query filters pagination nested authorization and safe display resources', function (): void {
    $admin = permanentUser('admin');
    $manager = permanentUser();
    $contextManager = permanentUser();
    $member = permanentUser('member');
    $other = permanentUser();
    $project = permanentProject($manager);
    $otherProject = permanentProject($other);
    app(ProjectMemberService::class)->addMember($project, $contextManager, ProjectMemberRole::Manager, actor: $manager);
    app(ProjectMemberService::class)->addMember($project, $member, ProjectMemberRole::Member, actor: $manager);
    $task = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'Scoped API activity', 'priority' => 'medium', 'assignee_id' => $member->id]));
    $otherTask = app(TaskService::class)->create($other, $otherProject, CreateTaskData::fromArray($otherProject->id, ['title' => 'Excluded API activity', 'priority' => 'medium']));
    $member->givePermissionTo(\App\Enums\PermissionName::ActivityView->value);

    $this->getJson('/api/v1/activity')->assertUnauthorized();
    permanentApiActor($manager, ['tasks:read']);
    $this->getJson('/api/v1/activity')->assertForbidden();
    $plain = User::factory()->create();
    permanentApiActor($plain, ['activity:read']);
    $this->getJson('/api/v1/activity')->assertForbidden();
    permanentApiActor($admin, ['activity:read']);
    $this->getJson('/api/v1/activity?event=task.created&project='.$project->id.'&task='.$task->id.'&actor='.$manager->id.'&date_from='.now()->toDateString().'&date_to='.now()->toDateString().'&per_page=1')
        ->assertOk()->assertJsonPath('meta.per_page', 1)->assertJsonFragment(['event' => 'task.created'])->assertJsonFragment(['display' => 'Task created'])->assertJsonMissing(['password' => $admin->password]);
    permanentApiActor($manager, ['activity:read']);
    $this->getJson('/api/v1/activity?project='.$project->id)->assertOk()->assertJsonFragment(['task_id' => $task->id])->assertJsonMissing(['task_id' => $otherTask->id]);
    permanentApiActor($contextManager, ['activity:read']);
    $this->getJson('/api/v1/projects/'.$project->id.'/activity')->assertOk()->assertJsonFragment(['task_id' => $task->id])->assertJsonMissing(['task_id' => $otherTask->id]);
    permanentApiActor($member, ['activity:read']);
    $this->getJson('/api/v1/tasks/'.$task->id.'/activity')->assertOk()->assertJsonFragment(['task_id' => $task->id]);
    permanentApiActor($manager, ['activity:read']);
    $this->getJson('/api/v1/tasks/'.$otherTask->id.'/activity')->assertForbidden();
});

test('Dashboard API keeps permission scopes summaries my tasks and overdue definitions in DashboardService', function (): void {
    $admin = permanentUser('admin');
    $manager = permanentUser();
    $contextManager = permanentUser();
    $member = permanentUser('member');
    $other = permanentUser();
    $project = permanentProject($manager);
    $otherProject = permanentProject($other);
    app(ProjectMemberService::class)->addMember($project, $contextManager, ProjectMemberRole::Manager, actor: $manager);
    app(ProjectMemberService::class)->addMember($project, $member, ProjectMemberRole::Member, actor: $manager);
    $pastTodo = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'Past todo API', 'priority' => 'medium', 'assignee_id' => $member->id]));
    $pastProgress = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'Past progress API', 'priority' => 'medium']));
    $pastDone = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'Past done API', 'priority' => 'medium']));
    $pastCancelled = app(TaskService::class)->create($manager, $project, CreateTaskData::fromArray($project->id, ['title' => 'Past cancelled API', 'priority' => 'medium']));
    $future = app(TaskService::class)->create($other, $otherProject, CreateTaskData::fromArray($otherProject->id, ['title' => 'Future other API', 'priority' => 'medium', 'assignee_id' => $other->id]));
    $pastTodo->update(['due_at' => now()->subDay()]);
    $pastProgress->update(['status' => TaskStatus::InProgress, 'due_at' => now()->subDay()]);
    $pastDone->update(['status' => TaskStatus::Done, 'due_at' => now()->subDay(), 'completed_at' => now()]);
    $pastCancelled->update(['status' => TaskStatus::Cancelled, 'due_at' => now()->subDay()]);
    $future->update(['due_at' => now()->addDay()]);

    $this->getJson('/api/v1/dashboard/summary')->assertUnauthorized();
    permanentApiActor($manager, ['tasks:read']);
    $this->getJson('/api/v1/dashboard/summary')->assertForbidden();
    $plain = User::factory()->create();
    permanentApiActor($plain, ['dashboard:read']);
    $this->getJson('/api/v1/dashboard/summary')->assertForbidden();
    permanentApiActor($admin, ['dashboard:read']);
    $this->getJson('/api/v1/dashboard/summary')->assertOk()->assertJsonPath('data.total_tasks', 5)->assertJsonPath('data.overdue', 2)->assertJsonPath('data.completed_today', 1);
    permanentApiActor($manager, ['dashboard:read']);
    $this->getJson('/api/v1/dashboard/summary')->assertOk()->assertJsonPath('data.total_tasks', 4)->assertJsonPath('data.overdue', 2);
    permanentApiActor($contextManager, ['dashboard:read']);
    $this->getJson('/api/v1/dashboard/summary')->assertOk()->assertJsonPath('data.total_tasks', 4);
    permanentApiActor($member, ['dashboard:read']);
    $this->getJson('/api/v1/dashboard/my-tasks')->assertOk()->assertJsonFragment(['id' => $pastTodo->id])->assertJsonMissing(['title' => 'Future other API']);
    permanentApiActor($admin, ['dashboard:read']);
    $this->getJson('/api/v1/dashboard/overdue?per_page=20')->assertOk()->assertJsonPath('meta.per_page', 20)->assertJsonFragment(['title' => 'Past todo API'])->assertJsonFragment(['title' => 'Past progress API'])->assertJsonMissing(['title' => 'Past done API'])->assertJsonMissing(['title' => 'Past cancelled API']);
});

// TASK-030 Stabilization Regression
test('Web project and task indexes only expose records and filter options within the actor scope', function (): void {
    $manager = permanentUser();
    $member = permanentUser('member');
    $outsider = permanentUser();
    $visibleProject = permanentProject($manager);
    $visibleProject->update(['name' => 'Visible member project']);
    $hiddenProject = permanentProject($outsider);
    $hiddenProject->update(['name' => 'Hidden outsider project']);
    app(ProjectMemberService::class)->addMember($visibleProject, $member, ProjectMemberRole::Member, actor: $manager);

    $visibleTask = app(TaskService::class)->create($manager, $visibleProject, CreateTaskData::fromArray($visibleProject->id, ['title' => 'Visible assigned task', 'priority' => 'medium', 'assignee_id' => $member->id]));
    app(TaskService::class)->create($manager, $visibleProject, CreateTaskData::fromArray($visibleProject->id, ['title' => 'Hidden unassigned task', 'priority' => 'medium']));
    app(TaskService::class)->create($outsider, $hiddenProject, CreateTaskData::fromArray($hiddenProject->id, ['title' => 'Hidden outsider task', 'priority' => 'medium', 'assignee_id' => $outsider->id]));

    $this->actingAs($member)->get('/projects')
        ->assertOk()
        ->assertSee('Visible member project')
        ->assertDontSee('Hidden outsider project');
    $this->actingAs($member)->get('/tasks')
        ->assertOk()
        ->assertSee($visibleTask->title)
        ->assertDontSee('Hidden unassigned task')
        ->assertDontSee('Hidden outsider task')
        ->assertDontSee('Hidden outsider project');
});

// Admin User Management Regression
test('Admin user routes and navigation are protected for the admin role only', function (): void {
    $admin = permanentUser('admin');
    $manager = permanentUser();
    $member = permanentUser('member');

    $this->get('/admin/users')->assertRedirect('/login');
    $this->actingAs($member)->get('/admin/users')->assertForbidden();
    $this->actingAs($manager)->get('/admin/users')->assertForbidden();
    $this->actingAs($admin)->get('/admin/users')->assertOk()->assertSee('User Management')->assertSee('aria-current="page"', false);
    $this->actingAs($admin)->get('/')->assertSee('User Management');
    $this->actingAs($manager)->get('/')->assertDontSee('User Management');
    $this->actingAs($member)->get('/')->assertDontSee('User Management');
    $this->actingAs($member)->post('/admin/users', ['name' => 'Blocked', 'email' => 'blocked@example.test', 'password' => 'SecurePassword123!', 'password_confirmation' => 'SecurePassword123!', 'role' => 'member'])->assertForbidden();
    $this->actingAs($member)->put('/admin/users/'.$admin->id, ['name' => 'Blocked edit', 'email' => $admin->email, 'role' => 'member'])->assertForbidden();
});

test('Admin creates internal users with a single selected canonical role and no password exposure', function (): void {
    $admin = permanentUser('admin');
    $password = 'SecurePassword123!';
    $payload = ['name' => 'Provisioned Member', 'email' => 'provisioned@example.test', 'password' => $password, 'password_confirmation' => $password, 'role' => 'member'];

    $this->actingAs($admin)->post('/admin/users', $payload)->assertRedirect();
    $created = User::query()->where('email', $payload['email'])->sole();
    expect($created->name)->toBe('Provisioned Member')->and($created->password)->not->toBe($password)->and(\Illuminate\Support\Facades\Hash::check($password, $created->password))->toBeTrue()->and($created->getRoleNames()->all())->toBe(['member']);
    $this->actingAs($admin)->get('/admin/users/create')->assertOk()->assertDontSee($password)->assertDontSee($created->password);
    $this->actingAs($admin)->post('/admin/users', $payload)->assertSessionHasErrors('email');
    $this->actingAs($admin)->post('/admin/users', [...$payload, 'email' => 'invalid-role@example.test', 'role' => 'not-a-role'])->assertSessionHasErrors('role');
    $this->actingAs($admin)->get('/admin/users/'.$created->id.'/edit')->assertOk()->assertDontSee($password)->assertDontSee($created->password);
});

test('Admin role updates synchronize global roles without touching project membership roles and retain an admin', function (): void {
    $admin = permanentUser('admin');
    $secondAdmin = permanentUser('admin');
    $target = permanentUser('member');
    $project = permanentProject($admin);
    app(ProjectMemberService::class)->addMember($project, $target, ProjectMemberRole::Manager, actor: $admin);

    $this->actingAs($admin)->put('/admin/users/'.$target->id, ['name' => 'Updated Global User', 'email' => 'updated-global@example.test', 'role' => 'project_manager'])->assertRedirect();
    $target->refresh();
    expect($target->name)->toBe('Updated Global User')->and($target->email)->toBe('updated-global@example.test')->and($target->getRoleNames()->all())->toBe(['project_manager']);
    $this->actingAs($admin)->put('/admin/users/'.$target->id, ['name' => $target->name, 'email' => $target->email, 'role' => 'member'])->assertRedirect();
    $target->refresh();
    expect($target->getRoleNames()->all())->toBe(['member'])
        ->and(\Modules\Projects\Models\ProjectMember::query()->where('project_id', $project->id)->where('user_id', $target->id)->sole()->member_role)->toBe(ProjectMemberRole::Manager);

    $this->actingAs($admin)->put('/admin/users/'.$admin->id, ['name' => $admin->name, 'email' => $admin->email, 'role' => 'member'])->assertRedirect();
    $admin->refresh();
    expect($admin->hasRole('admin'))->toBeFalse()->and($secondAdmin->fresh()->hasRole('admin'))->toBeTrue();
    $this->actingAs($secondAdmin)->put('/admin/users/'.$secondAdmin->id, ['name' => $secondAdmin->name, 'email' => $secondAdmin->email, 'role' => 'member'])->assertSessionHasErrors('role');
    expect($secondAdmin->fresh()->hasRole('admin'))->toBeTrue();
});

test('Admin user index searches names emails and global roles without exposing sensitive fields', function (): void {
    $admin = permanentUser('admin');
    $manager = User::factory()->create(['name' => 'Searchable Manager', 'email' => 'manager-search@example.test']);
    $manager->assignRole('project_manager');
    $member = User::factory()->create(['name' => 'Filtered Member', 'email' => 'member-search@example.test']);
    $member->assignRole('member');
    foreach (range(1, 13) as $number) {
        $paginationUser = User::factory()->create(['name' => 'Pagination User '.str_pad((string) $number, 2, '0', STR_PAD_LEFT)]);
        $paginationUser->assignRole('member');
    }

    $this->actingAs($admin)->get('/admin/users?search=Searchable')->assertOk()->assertSee('Searchable Manager')->assertDontSee('Filtered Member');
    $this->actingAs($admin)->get('/admin/users?search=member-search@example.test')->assertOk()->assertSee('Filtered Member')->assertDontSee('Searchable Manager');
    $response = $this->actingAs($admin)->get('/admin/users?role=project_manager');
    $response->assertOk()->assertSee('Searchable Manager')->assertDontSee('Filtered Member')->assertDontSee($manager->password)->assertDontSee($member->password);
    $this->actingAs($admin)->get('/admin/users?page=2')->assertOk()->assertSee('Pagination User');
});
